# Только безопасные локальные примеры. Не копируйте этот файл как .env для production.
CATS_HOUSE_DATABASE_URL=postgresql+psycopg://cats_house:local-development-password@postgres:5432/cats_house
CATS_HOUSE_S3_ENDPOINT=http://minio:9000
CATS_HOUSE_S3_BUCKET=cats-house-media
CATS_HOUSE_OWNER_EMAIL=owner@example.test
# Хеш демонстрационного пароля change-me-before-starting. Перед любым не локальным запуском замените его.
CATS_HOUSE_OWNER_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$xjlWxky0oe9MppNyArtjHQ$E1NK2Cxo2D7V5Divrcgmp0Vtyz/25rpLLfQjiY8f2TE'
CATS_HOUSE_SESSION_SECRET=replace-this-with-a-unique-secret-of-at-least-32-characters

POSTGRES_DB=cats_house
POSTGRES_USER=cats_house
POSTGRES_PASSWORD=local-development-password

MINIO_ROOT_USER=cats-house
MINIO_ROOT_PASSWORD=local-development-minio-password
